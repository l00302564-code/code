/**
 * DLT Student Companion v0.1 validation shell.
 *
 * The Windows PC remains the only data source. This Android app is deliberately thin:
 * - remembers the home-LAN server address;
 * - one-time student pairing via a short-lived code generated by the parent PC;
 * - then opens the existing DLT UI full-screen with the Student session cookie;
 * - provides native file chooser/camera capture and Chinese TTS bridge;
 * - never stores a parent password, provider key, Learning Tracker database, or copied mastery data.
 */
public class MainActivity extends Activity {
    private static final String PREFS = "dlt_student_companion";
    private static final String KEY_SERVER = "server_url";
    private static final String DEFAULT_PORT = "8765";
    private static final int REQ_FILE = 4101;
    private static final int REQ_NEARBY = 4102;

    private FrameLayout root;
    private WebView webView;
    private View setupOverlay;
    private TextView setupStatus;
    private EditText serverInput;
    private EditText pairCodeInput;
    private ProgressBar setupProgress;
    private SharedPreferences prefs;
    private ExecutorService io = Executors.newCachedThreadPool();
    private String serverUrl = "";
    private boolean mainFrameLoaded = false;

    private ValueCallback<Uri[]> fileCallback;
    private Uri pendingCameraUri;

    private TextToSpeech tts;
    private volatile boolean ttsReady = false;
